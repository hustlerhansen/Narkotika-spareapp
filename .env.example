# NY START – environment variables
# Copy to apps/web/.env.local for local development. Never commit real values.

# --- Supabase (optional) ------------------------------------------------------
# Without these the app runs fully local (no accounts). Both are PUBLIC by design
# (shipped to the browser); data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Technical error counts (optional, OFF by default) --------------------------
# When "true" (and Supabase is configured) the app counts coded errors per day:
# error code + coarse area + release. No user id, URL, text or stack trace.
# Mention it in the privacy notice before enabling (docs/PRIVACY_COMPLIANCE.md).
NEXT_PUBLIC_ERROR_REPORTING=false
# NEXT_PUBLIC_RELEASE=web-2026-10-10

# --- AI support (server-only; DISABLED unless exactly "true") ------------------
# Never prefix with NEXT_PUBLIC_. Do not enable in production before the launch
# blockers in docs/AI_SAFETY.md and docs/LAUNCH_READINESS.md are closed.
AI_COACH_ENABLED=false
# mock = deterministic test engine (no real model); anthropic = Anthropic API
AI_PROVIDER=
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_RATE_PER_MINUTE=6
# AI_PER_CLIENT_DAILY=40
# AI_DAILY_LIMIT=500
# A real model (AI_PROVIDER=anthropic) is only enabled with the SHARED rate-limit
# store, so limits hold across server instances (docs/AI_EVALUATION_PLAN.md):
# AI_RATE_LIMIT_STORE=postgres
# AI_RATE_LIMIT_SALT=                # ≥ 32 random characters, server-only
# SUPABASE_SERVICE_ROLE_KEY=         # server-only, never NEXT_PUBLIC_

# --- Server-only (future phases – never prefix with NEXT_PUBLIC_) --------------
# SUPABASE_SERVICE_ROLE_KEY=      # Phase 5 webhooks / admin jobs only
# STRIPE_SECRET_KEY=              # Phase 5
# STRIPE_WEBHOOK_SECRET=          # Phase 5

# --- Tests --------------------------------------------------------------------
# Supabase integration/E2E tests read API_URL, ANON_KEY, SERVICE_ROLE_KEY from
# `supabase status -o env` (local throw-away stack only; see docs/TESTING.md).
# PG_BIN=/usr/lib/postgresql/16/bin          # location of initdb/pg_ctl for DB tests
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=            # use a pre-installed Chromium
# E2E_PORT=3100
