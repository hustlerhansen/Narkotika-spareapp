{
  "name": "ny-start",
  "private": true,
  "description": "NY START \u2013 Recovery Companion",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nystart/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter @nystart/core --filter @nystart/web --filter @nystart/db-tests test",
    "test:db": "pnpm --filter @nystart/db-tests test",
    "test:e2e": "pnpm --filter @nystart/web test:e2e"
  }
}
